<?xml version="1.0" encoding="utf-8"?>
<!-- Palette popup enter: scale from 0.96 + translate Y 12 + fade in -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint">
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="220" />
    <scale
        android:fromXScale="0.96"
        android:toXScale="1"
        android:fromYScale="0.96"
        android:toYScale="1"
        android:pivotX="100%"
        android:pivotY="100%"
        android:duration="220" />
    <translate
        android:fromYDelta="12"
        android:toYDelta="0"
        android:duration="220" />
</set>
