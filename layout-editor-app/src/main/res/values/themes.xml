<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LayoutEditor" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/editor_primary_bright</item>
        <item name="colorOnPrimary">@color/editor_on_primary</item>
        <item name="colorPrimaryContainer">@color/editor_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/editor_primary_light</item>
        <item name="colorSecondary">@color/editor_primary_light</item>
        <item name="colorOnSecondary">@color/editor_on_primary</item>
        <item name="colorSurface">@color/editor_surface</item>
        <item name="colorOnSurface">@color/editor_on_surface</item>
        <item name="colorOutline">@color/editor_outline</item>
        <item name="android:statusBarColor">@color/editor_bg</item>
        <item name="android:navigationBarColor">@color/editor_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/editor_bg</item>
    </style>

    <!-- Thème pour CrashActivity (sans app bar native, status bar rouge) -->
    <style name="Theme.LayoutEditor.Crash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/editor_error</item>
        <item name="colorOnPrimary">@color/editor_white</item>
        <item name="colorSurface">@color/editor_surface</item>
        <item name="colorOnSurface">@color/editor_on_surface</item>
        <item name="android:statusBarColor">@color/editor_error</item>
        <item name="android:navigationBarColor">@color/editor_surface</item>
        <item name="android:windowBackground">@color/editor_bg</item>
    </style>

    <!-- Mode tab buttons -->
    <style name="Widget.LayoutEditor.ModeTab" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/mode_tab_height</item>
        <item name="android:textSize">@dimen/text_medium_13</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/editor_on_surface_3</item>
        <item name="cornerRadius">@dimen/mode_tab_corner</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <!-- Bottom sheet tab buttons -->
    <style name="Widget.LayoutEditor.BottomSheetTab" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">@dimen/bs_tab_height</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:textSize">@dimen/text_small_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/editor_on_surface_3</item>
        <item name="cornerRadius">@dimen/bs_tab_corner</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Icon button (round) -->
    <!-- Property input -->
    <!-- Tree node row -->
    <!-- FAB squared shape -->
    <style name="FabSquared" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/fab_corner</item>
    </style>

    <!-- Palette popup animation style -->
    <style name="PalettePopupAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/palette_popup_enter</item>
        <item name="android:windowExitAnimation">@anim/palette_popup_exit</item>
    </style>

    <!-- BottomNavigationView style — Material 3 dark, active item with pill indicator -->
    <!-- Active indicator : pill violet avec opacité -->
    <style name="Widget.LayoutEditor.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/editor_primary_container</item>
        <item name="android:width">@dimen/bn_icon_wrap_w</item>
        <item name="android:height">@dimen/bn_icon_wrap_h</item>
    </style>
</resources>
