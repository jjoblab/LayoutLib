<?xml version="1.0" encoding="utf-8"?>
<!-- prop_input_bg.xml — Background pour les champs de propriété.
     Default : bg surface-2 + border outline-3 + corner 9dp.
     Focused : border primary-bright + bg surface-3 (simule le box-shadow du CSS). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/editor_surface_3" />
            <stroke android:width="1.5dp" android:color="@color/editor_primary_bright" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/editor_surface_2" />
            <stroke android:width="1dp" android:color="@color/editor_outline" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/editor_surface_2" />
            <stroke android:width="1dp" android:color="@color/editor_outline_3" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
