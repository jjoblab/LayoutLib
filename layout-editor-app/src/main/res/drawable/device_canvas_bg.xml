<?xml version="1.0" encoding="utf-8"?>
<!-- device_canvas_bg.xml : Background du device canvas (frame du telephone).
     Simule le .device-canvas du HTML preview :
     box-shadow: 1px outline-2 + 6px purple glow + drop shadow (via elevation)
     background: #15152a; border-radius: 22px; -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1 : purple glow ring (6px, rgba(124,92,255,0.04)) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A7C5CFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Layer 2 : border 1px outline-2 (#322F47) -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF322F47" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Layer 3 : bg #15152a -->
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF15152A" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
